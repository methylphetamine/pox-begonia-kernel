+static __always_inline void __nm_rcu_unlock(int *g) { (void)g; rcu_read_unlock(); }
+#define rcu_guard() rcu_read_lock(); int __attribute__((cleanup(__nm_rcu_unlock), unused)) __UNIQUE_ID(rcug)
