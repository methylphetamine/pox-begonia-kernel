+static inline struct nm_sop *nm_get_nm_sop(const struct super_operations *sop) {
+    if (likely(sop) && sop->evict_inode == nomount_hijacked_evict_inode)
+        return container_of(sop, struct nm_sop, fake_sop);
+    return NULL;
